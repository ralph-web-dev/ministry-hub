// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  churches  Church[]
  users     User[]
}

model Church {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  members        Member[]
  users          User[]
  attendanceRecords AttendanceRecord[]
  auditLogs      AuditLog[]
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  churchId       String?
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  church         Church?      @relation(fields: [churchId], references: [id])
  recordedAttendances AttendanceRecord[]
  auditLogs      AuditLog[]
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  ARCHIVED
}

enum BaptismStatus {
  BAPTIZED
  NOT_BAPTIZED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Member {
  id                String           @id @default(uuid())
  churchId          String
  memberId          String           @unique
  profilePictureUrl String?
  firstName         String
  middleName        String?
  lastName          String
  suffix            String?
  email             String?
  phoneNumber       String?
  dateOfBirth       DateTime?
  gender            Gender?
  address           String?
  membershipStatus  MembershipStatus @default(ACTIVE)
  dateJoined        DateTime?
  baptismStatus     BaptismStatus    @default(NOT_BAPTIZED)
  baptismDate       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  church            Church           @relation(fields: [churchId], references: [id])
  attendanceRecords AttendanceRecord[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AttendanceType {
  SUNDAY_WORSHIP
  MIDWEEK_SERVICE
  SPECIAL_EVENT
  YOUTH_FELLOWSHIP
  OUTREACH
  OTHER
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  churchId       String
  memberId       String
  attendanceDate DateTime
  attendanceType AttendanceType   @default(SUNDAY_WORSHIP)
  status         AttendanceStatus @default(PRESENT)
  eventId        String?
  notes          String?
  recordedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  church         Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy     User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([churchId, memberId, attendanceDate, attendanceType])
  @@index([churchId, attendanceDate])
  @@index([memberId])
  @@index([attendanceDate])
  @@index([attendanceType])
  @@index([status])
  @@index([eventId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String?
  churchId       String?
  userId         String?
  action         String
  module         String
  recordId       String?
  details        Json?
  createdAt      DateTime     @default(now())

  church         Church?      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([churchId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

